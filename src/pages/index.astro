  <script src="/js/flowfield.js" is:inline></script>
  <script is:inline>
    function toggleCard(card) {
      document.querySelectorAll('.card-reveal').forEach(function(c){ if(c!==card)c.classList.remove('flipped'); });
      card.classList.toggle('flipped');
    }
    function toggleToolCard(card) {
      card.classList.toggle('flipped');
    }

    var currentCardIndex = 0;
    var cards = [];
    var autoRotateInterval = null;

    function autoRotateCards() {
      cards.forEach(function(c){c.classList.remove('flipped')});
      setTimeout(function(){
        if(cards[currentCardIndex])cards[currentCardIndex].classList.add('flipped');
        currentCardIndex=(currentCardIndex+1)%cards.length;
      },300);
    }

    function initWhispers() {
      var cards = document.querySelectorAll('.whisper-card');
      var popup = document.getElementById('whisper-popup');
      var popupQuote = document.getElementById('whisper-popup-quote');
      var popupClose = document.getElementById('whisper-popup-close');
      if (!cards.length || !popup) return;
      // Cache the per-card quote text so we can echo it inside the popup.
      var quotes = [];
      cards.forEach(function (c) {
        quotes.push((c.querySelector('.whisper-text') || {}).textContent || '');
      });
      function open(idx) {
        popupQuote.textContent = quotes[idx] || '';
        popup.classList.add('open');
        popup.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        popup.classList.remove('open');
        popup.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      cards.forEach(function (c, idx) {
        c.addEventListener('click', function () { open(idx); });
      });
      popupClose && popupClose.addEventListener('click', close);
      popup.addEventListener('click', function (e) { if (e.target === popup) close(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && popup.classList.contains('open')) close();
      });
    }

    function initMouseTrail() {
      var container = document.getElementById('mouse-trail');
      if(!container) return;
      // clear any existing listeners by replacing container
      var newContainer = container.cloneNode(true);
      container.parentNode.replaceChild(newContainer, container);
      var trail=[],max=26,lastX=0,lastY=0,lastT=0;
      document.addEventListener('mousemove',function(e){
        // throttle: only spawn a cloud every ~28px of movement, keeps it soft not noisy
        var dx=e.clientX-lastX, dy=e.clientY-lastY, dist=Math.sqrt(dx*dx+dy*dy);
        if(dist<26) return;
        lastX=e.clientX; lastY=e.clientY;
        var p=document.createElement('div');p.className='particle';
        p.style.left=e.clientX+'px';p.style.top=e.clientY+'px';
        // soft pastel cloud tints
        var tints=[
          'radial-gradient(circle, rgba(255,255,255,0.85) 0%, rgba(232,164,176,0.4) 35%, rgba(232,164,176,0.1) 65%, transparent 100%)',
          'radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(147,112,219,0.4) 35%, rgba(147,112,219,0.1) 65%, transparent 100%)',
          'radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(80,200,220,0.4) 35%, rgba(80,200,220,0.1) 65%, transparent 100%)',
          'radial-gradient(circle, rgba(255,255,255,0.82) 0%, rgba(240,160,190,0.4) 35%, rgba(240,160,190,0.1) 65%, transparent 100%)'
        ];
        p.style.background=tints[Math.floor(Math.random()*tints.length)];
        // slight size/rotation variance for a fluffy, organic feel
        var s=0.8+Math.random()*0.9;
        p.style.width=(28*s)+'px'; p.style.height=(28*s)+'px';
        p.style.filter='blur('+(5+Math.random()*3)+'px)';
        newContainer.appendChild(p);trail.push(p);
        if(trail.length>max){var o=trail.shift();if(o.parentNode)o.parentNode.removeChild(o);}
      });
    }

    function initParticlesContainer() {
      var wrap = document.getElementById('particles-container');
      if(!wrap) return;
      wrap.innerHTML = '';
      var frag = document.createDocumentFragment();
      for (var i = 0; i < 40; i++) {
        var s = document.createElement('div');
        s.className = 'mystical-particle';
        s.style.cssText = 'width:'+(2+Math.random()*3)+'px;height:'+(2+Math.random()*3)+'px;left:'+(Math.random()*100)+'%;top:'+(Math.random()*100)+'%;opacity:'+(0.2+Math.random()*0.4)+';animation:float '+(4+Math.random()*4)+'s ease-in-out infinite;animation-delay:'+(Math.random()*-4)+'s;';
        frag.appendChild(s);
      }
      wrap.appendChild(frag);
    }

    function initHomeScripts() {
      if (typeof window.initFlowField === 'function') window.initFlowField();
      initMouseTrail();
      initParticlesContainer();
      initWhispers();
      if (autoRotateInterval) clearInterval(autoRotateInterval);
      cards = document.querySelectorAll('.tool-reveal');
      if(cards.length) {
        currentCardIndex = 0;
        autoRotateInterval = setInterval(autoRotateCards,8000);
        setTimeout(autoRotateCards,3000);
      }
      document.querySelectorAll('a[href^="#"]').forEach(function(a){
        a.addEventListener('click',function(e){
          e.preventDefault();
          var t=document.querySelector(this.getAttribute('href'));
          if(t)t.scrollIntoView({behavior:'smooth',block:'start'});
        });
      });
    }

    document.addEventListener('astro:page-load', initHomeScripts);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomeScripts);
    } else {
      initHomeScripts();
    }
  </script>
