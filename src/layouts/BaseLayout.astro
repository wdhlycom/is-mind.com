---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD object injected into <head> (e.g. Article / WebSite). */
  schema?: Record<string, unknown> | null;
  /** Set true on the home page to skip the standard article chrome. */
  isHome?: boolean;
  /** Optional body class wrapper for section-specific light-mode overrides. */
  bodyClass?: string;
  /** Current page language: en (default) | zh | es. */
  lang?: 'en' | 'zh' | 'es';
}
const { title, description, schema = null, isHome = false, bodyClass = '', lang = 'en' } = Astro.props;
const siteTitle = 'is-mind.com: The engine for your mind';
const fullTitle = title ? `${title} | is-mind.com` : siteTitle;
const desc = description ?? 'Decode the Language of Your Soul — ancient wisdom meets modern insight.';
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#211B43" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content="is-mind.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <!-- Unified navbar — left-aligned nav, right utilities -->
    <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md" style="background: rgba(33, 27, 67, 0.92);">
      <div class="w-full px-6 lg:px-10 py-2">
        <div class="flex items-center justify-between gap-4">
          <!-- Left: logo + main menu -->
          <div class="flex items-center gap-5 lg:gap-8 overflow-hidden">
            <button id="logo-music-toggle" class="flex-shrink-0 rounded-full overflow-hidden border border-[#E8A4B0]/30 w-10 h-10 p-0 bg-transparent cursor-pointer" aria-label="Play the energy channel" title="Play the energy channel">
              <img id="logo-img" src="/img/logo.png" alt="is-mind.com" class="w-full h-full object-cover transition-transform duration-700">
            </button>
            <div class="hidden md:flex items-center gap-4 lg:gap-6 flex-nowrap">
              <a href="/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Home</a>
              <a href="/tarot/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Tarot & Oracle</a>
              <a href="/psych/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Mind & Psych</a>
              <a href="/energy/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Energy & Chakras</a>
              <a href="/astrology/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Astrology & Symbols</a>
              <a href="/reviews/" class="text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300">Reviews & Tools</a>
            </div>
          </div>

          <!-- Right: About us, language switch, search, theme toggle -->
          <div class="flex items-center gap-1 lg:gap-2">
            <a href="/about/" class="hidden md:inline-block text-white/85 hover:text-[#E8A4B0] font-bold text-sm whitespace-nowrap transition-colors duration-300 px-2">About us</a>
            <span class="hidden md:inline-block text-white/20 px-1">|</span>

            <!-- Language toggle: shows current locale, click switches to the other (like the theme toggle) -->
            <button id="lang-toggle" class="p-2 text-white/80 hover:text-[#E8A4B0] transition-colors flex items-center gap-1.5" aria-label="Switch language">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" /><path stroke-linecap="round" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span id="lang-label" class="text-xs font-bold">{lang === 'en' ? 'EN' : lang === 'es' ? 'ES' : 'ES'}</span>
            </button>

            <!-- Search: icon expands into input -->
            <div class="relative flex items-center" id="nav-search-wrap">
              <button id="nav-search-btn" class="p-2 text-white/80 hover:text-[#E8A4B0] transition-colors" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </button>
              <form id="nav-search-form" action="/" method="get" class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center overflow-hidden transition-all duration-300 ease-out w-0 opacity-0 pointer-events-none">
                <input type="text" name="search" placeholder="Search..." class="w-40 lg:w-56 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-sm text-white placeholder-white/50 focus:outline-none focus:border-[#E8A4B0]">
                <button type="submit" class="ml-2 p-1.5 text-white/70 hover:text-[#E8A4B0] transition-colors" aria-label="Submit search">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </form>
            </div>

            <!-- Theme toggle -->
            <button id="theme-toggle" class="p-2 text-white/80 hover:text-[#E8A4B0] transition-colors" aria-label="Toggle dark mode">
              <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </button>

            <!-- Mobile menu button -->
            <button id="mobile-menu-btn" class="md:hidden p-2 text-white" aria-label="Menu">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile menu panel -->
    <div id="mobile-menu-panel" class="fixed top-12 left-0 right-0 z-40 backdrop-blur-md hidden" style="background: rgba(33, 27, 67, 0.95);">
      <div class="px-6 py-4 flex flex-col space-y-4">
        <a href="/" class="text-white font-bold py-2 border-b border-gray-700/50">Home</a>
        <a href="/tarot/" class="text-white font-bold py-2 border-b border-gray-700/50">Tarot & Oracle</a>
        <a href="/psych/" class="text-white font-bold py-2 border-b border-gray-700/50">Mind & Psych</a>
        <a href="/energy/" class="text-white font-bold py-2 border-b border-gray-700/50">Energy & Chakras</a>
        <a href="/astrology/" class="text-white font-bold py-2 border-b border-gray-700/50">Astrology & Symbols</a>
        <a href="/reviews/" class="text-white font-bold py-2 border-b border-gray-700/50">Reviews & Tools</a>
        <a href="/about/" class="text-white font-bold py-2 border-b border-gray-700/50">About us</a>
        <form action="/" method="get" class="pt-2">
          <div class="flex items-center bg-white/10 border border-white/20 rounded-full px-4 py-2">
            <input type="text" name="search" placeholder="Search..." class="bg-transparent text-sm text-white placeholder-white/50 focus:outline-none flex-1">
            <button type="submit" class="text-white/70 hover:text-[#E8A4B0]">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </div>
        </form>
        <div class="flex items-center justify-between pt-2">
          <button id="mobile-theme-toggle" class="flex items-center gap-2 text-white/80 hover:text-[#E8A4B0]">
            <svg class="moon-icon h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            <svg class="sun-icon h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <span class="text-sm font-bold">Theme</span>
          </button>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <!-- Floating community message button (all pages) -->
    <a href="/community/" class="community-fab" aria-label="Leave a message">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="community-fab-text">Message</span>
    </a>

    <footer class="py-6 text-center" style="background: #211B43;">
      <div class="w-full px-3 sm:px-6">
        <p class="text-xs" style="color: #565070;">
          <a href="/disclosure/" style="color:#565070; text-decoration:underline;">Disclosure</a>: This website <a href="/reviews/" style="color:#565070; text-decoration:underline;">contains affiliate links</a>. We may earn commissions from purchases made through our recommendations.
        </p>
        <p class="text-xs mt-1" style="color: #565070;">
          <a href="/privacy/" style="color:#565070; text-decoration:underline;">Privacy Policy</a> · <a href="/disclaimer/" style="color:#565070; text-decoration:underline;">Disclaimer</a> · <a href="/about/editorial-policy/" style="color:#565070; text-decoration:underline;">Editorial Policy</a> · <a href="/about/editorial-team/" style="color:#565070; text-decoration:underline;">Editorial Team</a> · © {new Date().getFullYear()} is-mind.com. All rights reserved.
        </p>
      </div>
    </footer>

    <!-- Ambient audio, wired to the nav logo. No popup, no new tab: the video is
         embedded as a near-invisible sliver. It has to stay technically rendered
         (YouTube refuses to autoplay a display:none embed), hence opacity 0.01
         rather than hidden — the source is never actually shown. -->
    <div id="yt-frame-host" aria-hidden="true"></div>

    <script is:inline>
    (function(){
      function updateThemeIcon(isDark){
        var moon = document.getElementById('theme-icon-moon');
        var sun = document.getElementById('theme-icon-sun');
        if(moon) moon.classList.toggle('hidden', !isDark);
        if(sun) sun.classList.toggle('hidden', isDark);
        var mobileMoon = document.querySelector('#mobile-theme-toggle .moon-icon');
        var mobileSun = document.querySelector('#mobile-theme-toggle .sun-icon');
        if(mobileMoon) mobileMoon.classList.toggle('hidden', !isDark);
        if(mobileSun) mobileSun.classList.toggle('hidden', isDark);
      }
      function applyStoredTheme(){
        var stored = localStorage.getItem('theme');
        var isDark = stored ? stored === 'dark' : true;
        document.documentElement.classList.toggle('dark', isDark);
        updateThemeIcon(isDark);
      }
      function toggleTheme(){
        var isDark = document.documentElement.classList.contains('dark');
        var makeDark = !isDark;
        document.documentElement.classList.toggle('dark', makeDark);
        localStorage.setItem('theme', makeDark ? 'dark' : 'light');
        updateThemeIcon(makeDark);
      }

      function initSearch(){
        var btn = document.getElementById('nav-search-btn');
        var form = document.getElementById('nav-search-form');
        var input = form ? form.querySelector('input') : null;
        if(!btn || !form) return;
        function open(){ form.classList.add('open'); form.classList.remove('w-0','opacity-0','pointer-events-none'); }
        function close(){ form.classList.remove('open'); form.classList.add('w-0','opacity-0','pointer-events-none'); }
        btn.addEventListener('click', function(e){ e.stopPropagation(); form.classList.contains('open') ? close() : open(); if(form.classList.contains('open') && input) setTimeout(function(){ input.focus(); }, 50); });
        document.addEventListener('click', function(e){ if(!btn.contains(e.target) && !form.contains(e.target)) close(); });
      }

      function initMobileMenu(){
        var btn = document.getElementById('mobile-menu-btn');
        var panel = document.getElementById('mobile-menu-panel');
        if(btn && panel){
          btn.addEventListener('click', function(e){ e.stopPropagation(); panel.classList.toggle('hidden'); });
          document.addEventListener('click', function(e){ if(!btn.contains(e.target) && !panel.contains(e.target)) panel.classList.add('hidden'); });
        }
        var mobileTheme = document.getElementById('mobile-theme-toggle');
        if(mobileTheme) mobileTheme.addEventListener('click', toggleTheme);
      }

      // Ambient audio behind the nav logo. No popup, no new tab — the video is
      // embedded as an invisible sliver and simply plays.
      var YT_VIDEO = '4TSFUy3gE5I';
      var YT_EMBED = 'https://www.youtube.com/embed/' + YT_VIDEO;

      function initLogoPlayer(){
        var btn = document.getElementById('logo-music-toggle');
        var host = document.getElementById('yt-frame-host');
        var img = document.getElementById('logo-img');
        if(!btn || !host) return;

        var playing = false;

        function start(){
          host.innerHTML = '';
          var f = document.createElement('iframe');
          f.title = 'ambient audio';
          f.allow = 'autoplay; encrypted-media';
          // Has to stay rendered or autoplay is refused — hence opacity 0.01
          // instead of display:none. loop needs the matching playlist param.
          f.style.cssText = 'position:fixed;left:0;bottom:0;width:180px;height:101px;opacity:0.01;pointer-events:none;border:0;z-index:1;';
          f.src = YT_EMBED + '?autoplay=1&loop=1&playlist=' + YT_VIDEO +
                  '&rel=0&controls=0&modestbranding=1&playsinline=1';
          host.appendChild(f);
          playing = true;
          if(img) img.classList.add('logo-spin');
        }

        function stop(){
          host.innerHTML = ''; // destroying the iframe is what stops the audio
          playing = false;
          if(img) img.classList.remove('logo-spin');
        }

        btn.addEventListener('click', function(e){
          e.stopPropagation();
          if(playing) { stop(); } else { start(); }
        });
      }

      function initLangToggle(){
        var btn = document.getElementById('lang-toggle');
        var label = document.getElementById('lang-label');
        if(!btn) return;
        var cur = (document.documentElement.lang || 'en').toLowerCase();
        var isEs = cur === 'es';
        if(label) label.textContent = isEs ? 'ES' : 'EN';
        btn.addEventListener('click', function(){
          // One-tap switch: on the ES page go back to EN home; everywhere else go to ES home.
          window.location.href = isEs ? '/' : '/es/';
        });
      }

      function initAll(){
        applyStoredTheme();
        var t = document.getElementById('theme-toggle');
        if(t) t.addEventListener('click', toggleTheme);
        initSearch();
        initMobileMenu();
        initLogoPlayer();
        initLangToggle();
      }

      document.addEventListener('astro:page-load', initAll);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    })();
    </script>
    <style is:global>
      /* ── Image lightbox (click to zoom) ── */
      .prose img { cursor: zoom-in; }
      .lb-overlay {
        position: fixed; inset: 0; z-index: 200;
        display: flex; align-items: center; justify-content: center;
        background: rgba(8,6,16,.88); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        opacity: 0; transition: opacity .22s ease;
      }
      .lb-overlay.open { opacity: 1; }
      .lb-overlay img {
        max-width: 92vw; max-height: 88vh; width: auto; height: auto;
        border-radius: 10px; box-shadow: 0 30px 90px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.12);
        transform: scale(.94); transition: transform .22s ease;
      }
      .lb-overlay.open img { transform: scale(1); }
      .lb-close {
        position: absolute; top: 18px; right: 22px;
        width: 40px; height: 40px; border-radius: 50%;
        border: 1px solid rgba(255,255,255,.25); background: rgba(255,255,255,.08);
        color: #fff; font-size: 22px; line-height: 1; cursor: pointer;
      }
      .lb-close:hover { background: rgba(255,255,255,.18); }
      body.lb-open { overflow: hidden; }
    </style>
    <script is:inline>
    (function () {
      var overlay = null;
      function closeLb() {
        if (!overlay) return;
        overlay.classList.remove('open');
        document.body.classList.remove('lb-open');
        setTimeout(function(){ if (overlay) { overlay.remove(); overlay = null; } }, 220);
      }
      document.addEventListener('click', function (e) {
        var img = e.target && e.target.closest ? e.target.closest('.prose img') : null;
        if (img) {
          e.preventDefault();
          if (overlay) overlay.remove();
          overlay = document.createElement('div');
          overlay.className = 'lb-overlay';
          overlay.innerHTML = '<button class="lb-close" aria-label="Close">&times;</button>';
          var big = document.createElement('img');
          big.src = img.currentSrc || img.src;
          big.alt = img.alt || '';
          overlay.appendChild(big);
          document.body.appendChild(overlay);
          document.body.classList.add('lb-open');
          requestAnimationFrame(function(){ overlay.classList.add('open'); });
          return;
        }
        if (overlay && (e.target === overlay || (e.target.closest && e.target.closest('.lb-close')))) closeLb();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLb(); });
    })();
    </script>
  </body>
</html>
