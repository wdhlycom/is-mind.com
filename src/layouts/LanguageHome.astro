---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** URL of the translated About page for this locale. */
  aboutUrl: string;
  /** Current locale: 'zh' | 'es'. */
  lang: 'zh' | 'es';
}
const { title, description, aboutUrl, lang } = Astro.props;
---
<BaseLayout title={title} description={description} bodyClass="dc-page" lang={lang}>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap');

    .dc-page {
      --gold: #E8A4B0;
      --gold-bright: #F3E5AB;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% -10%, #2B2254 0%, transparent 55%),
        radial-gradient(ellipse at 80% 110%, #322968 0%, transparent 50%),
        linear-gradient(180deg, #1A1534 0%, #1A1534 100%);
      position: relative;
      overflow: hidden;
      padding: 5rem 1.25rem 6rem;
    }
    .dc-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; text-align: center; }
    .dc-title {
      font-family: 'Playfair Display', Georgia, serif; font-weight: 700;
      font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.15;
      letter-spacing: .02em; margin: 0 0 .6rem;
      background: linear-gradient(90deg, #e8d8b8, var(--gold-bright), #c0a880);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .dc-sub {
      font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic;
      font-size: clamp(1rem, 2.4vw, 1.25rem); color: rgba(223,214,193,.72);
      max-width: 34rem; margin: 0 auto 2.2rem;
    }
    .dc-cta {
      display: inline-flex; align-items: center; gap: .5rem;
      font-family: 'Playfair Display', serif; font-weight: 600; font-size: .95rem; letter-spacing: .06em;
      padding: .85rem 2rem; border-radius: 9999px; color: #1a1206; text-decoration: none;
      background: linear-gradient(90deg, var(--gold), var(--gold-bright));
      box-shadow: 0 0 30px rgba(232,164,176,.35);
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .dc-cta:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 0 45px rgba(232,164,176,.6); }
    .dc-lang-row { display: flex; gap: 1rem; justify-content: center; margin-top: 2.2rem; }
    .dc-lang {
      font-family: 'Playfair Display', serif; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(232,164,176,.75); text-decoration: none; padding: .4rem .9rem;
      border: 1px solid rgba(232,164,176,.35); border-radius: 999px;
      transition: all .3s ease;
    }
    .dc-lang:hover { color: #fff; border-color: var(--gold-bright); background: rgba(232,164,176,.12); }

    html:not(.dark) .dc-page { background: radial-gradient(ellipse at 50% -10%, #ece3fb 0%, transparent 55%), linear-gradient(180deg, #f8f6fc 0%, #fbfaff 100%); }
    html:not(.dark) .dc-sub { color: #5b5470; }
    html:not(.dark) .dc-lang { color: #7c3aed; border-color: rgba(124,58,237,.4); }
  </style>

  <div class="dc-page">
    <div class="dc-inner">
      <h1 class="dc-title">{title}</h1>
      {description && <p class="dc-sub">{description}</p>}

      <a class="dc-cta" href={aboutUrl}>阅读我们的故事 / Read our story →</a>

      <div class="dc-lang-row">
        <a class="dc-lang" href="/">English</a>
        <a class="dc-lang" href="/zh/">中文</a>
        <a class="dc-lang" href="/es/">Español</a>
      </div>
    </div>
  </div>
</BaseLayout>
