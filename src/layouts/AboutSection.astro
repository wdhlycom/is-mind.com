---
import BaseLayout from './BaseLayout.astro';
import AtmosFlow from '../components/AtmosFlow.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface SubPage {
  title: string;
  url: string;
  description: string;
}

interface Props {
  entry: CollectionEntry<'pages'>;
  subPages: SubPage[];
}
const { entry, subPages } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout title={d.title} description={d.description}>
  <style is:global>
    .about-wrap { padding: 4.5rem 1.25rem 3rem; position: relative; z-index: 30; }
    .about-wrap .about-title {
      font-family: var(--display); font-weight: 700;
      font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; margin: 0 0 .4rem;
      background: linear-gradient(90deg, #e8d8b8, var(--gold-bright), #c0a880);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .about-wrap .about-sub { font-style: italic; color: rgba(243, 229, 171, .85); border-left: none; padding-left: 0; margin: .4rem 0 2.2rem; }
    .about-wrap .about-prose { max-width: 720px; }
    .about-wrap .about-prose h2 { font-family: var(--display); color: var(--gold-bright); margin-top: 2.4rem; font-size: 1.5rem; }
    .about-wrap .about-prose h3 { color: var(--ink); }
    .about-wrap .about-prose blockquote { border-left: none; border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; background-color: rgba(255,255,255,0.03); padding: 18px 22px; margin: 20px 0; color: var(--ink-soft); font-style: italic; }
    .about-wrap .about-prose p { color: var(--ink); line-height: 1.75; font-size: 1.12rem; }
    .about-wrap .about-prose strong { color: var(--gold-bright); }
    .about-wrap .about-prose hr { display: none !important; }
    .about-subgrid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 2.6rem; max-width: 720px; }
    @media (min-width: 640px) { .about-subgrid { grid-template-columns: repeat(3, 1fr); } }
    .about-subcard {
      display: block; padding: 1.2rem 1.3rem; border-radius: 14px;
      background: var(--panel); border: 1px solid var(--panel-border);
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .about-subcard:hover { transform: translateY(-3px); box-shadow: 0 0 30px rgba(232, 164, 176, .18); border-color: var(--gold-bright); }
    .about-subcard h3 { font-family: var(--display); color: var(--gold-bright); margin: 0 0 .4rem; font-size: 1.05rem; }
    .about-subcard p { color: var(--ink-soft); font-size: .85rem; margin: 0; line-height: 1.5; }

    html:not(.dark) .about-wrap .about-prose p { color: #2a2440; }
    html:not(.dark) .about-wrap .about-prose strong { color: #9a7614; }
    html:not(.dark) .about-wrap .about-prose h2 { color: #9a7614; }
    html:not(.dark) .about-wrap .about-sub { color: #5b5470; }
    html:not(.dark) .about-wrap .about-prose blockquote { border-color: rgba(124,58,237,0.25); background-color: rgba(124,58,237,0.04); color: #5a5478; }
    html:not(.dark) .about-subcard { background: rgba(255,255,255,0.62); border-color: rgba(232,164,176,0.32); }
    html:not(.dark) .about-subcard h3 { color: #9a7614; }
    html:not(.dark) .about-subcard p { color: #5a5478; }
  </style>

  <!-- The busiest field on the site: 400 round motes, slow drift, small radius.
       Fixed to the viewport; the prose below sits at z-30 so text stays crisp. -->
  <AtmosFlow
    fullscreen
    render="dot"
    density={3240}
    max={400}
    min={120}
    speed={0.3}
    dotScale={1.3}
    alpha={0.8}
  />

  <section class="about-wrap">
    <div class="container" style="max-width:760px">
      <h1 class="about-title">{d.title}</h1>
      {d.description && <p class="about-sub">{d.description}</p>}
      <div class="about-prose">
        <Content />
      </div>
      {subPages.length > 0 && (
        <div class="about-subgrid">
          {subPages.map((s) => (
            <a class="about-subcard" href={s.url}>
              <h3>{s.title}</h3>
              {s.description && <p>{s.description}</p>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
