---
import BaseLayout from './BaseLayout.astro';
import AtmosFlow from '../components/AtmosFlow.astro';

interface AstroItem {
  title: string;
  url: string;
  summary: string;
  shortDate: string;
}

interface Props {
  title: string;
  summary?: string;
  items: AstroItem[];
}
const { title, summary, items } = Astro.props;

const featured = items.find((it) => it.url.includes('/astrology-101-sun-moon-rising/'));
const rest = featured ? items.filter((it) => it.url !== featured.url) : items;

// Asymmetric column spans, cycles for the remaining cards.
const spans = [1, 2, 1, 1, 1, 1, 2, 1];

// Deterministic star positions (mirrors Hugo math.Mod loops).
const stars1 = Array.from({ length: 45 }, (_, i) => ({ left: (i * 31) % 98, top: (i * 47) % 95 }));
const stars2 = Array.from({ length: 30 }, (_, i) => ({ left: (i * 53) % 98, top: (i * 67) % 95 }));
const stars3 = Array.from({ length: 25 }, (_, i) => ({ left: (i * 71) % 98, top: (i * 29) % 95 }));
---
<BaseLayout title={title} description={summary} bodyClass="astro-page">
  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&display=swap");

    .star-fixed { position: absolute; border-radius: 50%; pointer-events: none; background: rgba(200, 195, 210, 0.35); }
    .sf-1 { width: 1px; height: 1px; }
    .sf-2 { width: 1.5px; height: 1.5px; background: rgba(210, 200, 180, 0.3); }
    .sf-3 { width: 0.8px; height: 0.8px; }

    @keyframes orbitSlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    @keyframes orbitReverse { 0% { transform: rotate(0deg); } 100% { transform: rotate(-360deg); } }

    .orbital-container {
      position: absolute; pointer-events: none; will-change: transform; border-radius: 50%;
      border: 1px solid rgba((212, 200, NaN), 160, 0.125);
      box-shadow: 0 0 12px rgba(212, 200, 160, 0.15), inset 0 0 12px rgba(212, 200, 160, 0.08);
    }
    .oc-1 { width: 75vw; height: 75vw; max-width: 700px; max-height: 700px; top: 10%; left: 50%; transform: translate(-50%, 0) rotateX(70deg); animation: orbitSlow 50s linear infinite; }
    .oc-2 { width: 60vw; height: 60vw; max-width: 550px; max-height: 550px; top: 18%; left: 50%; transform: translate(-50%, 0) rotateX(60deg) rotateY(20deg); animation: orbitReverse 45s linear infinite; }
    .oc-3 { width: 45vw; height: 45vw; max-width: 400px; max-height: 400px; top: 26%; left: 50%; transform: translate(-50%, 0) rotateX(55deg) rotateY(-15deg); animation: orbitSlow 40s linear infinite; }

    .zodiac-symbol { position: absolute; pointer-events: none; will-change: transform; font-size: 0.9rem; line-height: 1; opacity: 0.4; color: rgba(212, 200, 170, 0.9); text-shadow: 0 0 6px rgba(212, 200, 160, 0.5), 0 0 12px rgba(200, 180, 150, 0.25); }

    @keyframes auraPulse { 0%, 100% { transform: scale(1) translate(0, 0); opacity: 0.2; } 50% { transform: scale(1.15) translate(1vw, -1vh); opacity: 0.3; } }
    .aura-blob { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); will-change: transform, opacity; }
    .av-1 { top: 5%; left: 10%; width: 40vw; height: 35vh; background: radial-gradient(ellipse, rgba(160, 140, 200, 0.25) 0%, transparent 65%); animation: auraPulse 20s ease-in-out infinite; }
    .av-2 { bottom: 10%; right: 5%; width: 35vw; height: 30vh; background: radial-gradient(ellipse, rgba(200, 180, 140, 0.2) 0%, transparent 65%); animation: auraPulse 24s ease-in-out infinite; animation-delay: -10s; }

    @keyframes cardIn { 0% { opacity: 0; transform: translateY(16px); } 100% { opacity: 1; transform: translateY(0); } }
    .astro-card {
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      background: linear-gradient(160deg, rgba(40,20,70,0.45) 0%, rgba(20,10,45,0.6) 60%, rgba(15,8,35,0.7) 100%);
      border: 1px solid rgba((180,160, NaN),200, 0.06);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative; overflow: hidden; will-change: transform;
    }
    .astro-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(200,180,160,0.2), transparent); }
    .astro-card:hover { transform: translateY(-6px) scale(1.02); border-color: rgba(200,180,160,0.3); box-shadow: 0 0 35px rgba(180,150,110,0.06), 0 15px 35px -10px rgba(0,0,0,0.4); }

    .text-celestial { color: rgba(195, 185, 210, 0.8); font-weight: 300; }

    @keyframes mirrorOrbit { 0% { transform: translate(-50%, -50%) rotate(0deg); } 100% { transform: translate(-50%, -50%) rotate(-360deg); } }
    .mirror-orbital { position: absolute; pointer-events: none; will-change: transform; border-radius: 50%; border: 0.8px solid rgba(200,190,160,0.2); box-shadow: 0 0 8px rgba(200,180,150,0.12), inset 0 0 8px rgba(200,180,150,0.06); }
    .mo-1 { bottom: 5%; left: 20%; width: 35vw; height: 35vw; max-width: 350px; max-height: 350px; transform: translate(-50%, -50%) rotateX(65deg) rotateY(-15deg); animation: mirrorOrbit 35s linear infinite; }
    .mo-2 { bottom: 7%; left: 22%; width: 28vw; height: 28vw; max-width: 280px; max-height: 280px; transform: translate(-50%, -50%) rotateX(55deg) rotateY(10deg); animation: mirrorOrbit 30s linear infinite; border-color: rgba(180,170,150,0.09); }
    .mo-3 { bottom: 9%; left: 23%; width: 20vw; height: 20vw; max-width: 200px; max-height: 200px; transform: translate(-50%, -50%) rotateX(50deg) rotateY(-8deg); animation: mirrorOrbit 27s linear infinite; border-color: rgba(180,170,150,0.07); }
    .mirror-symbol { position: absolute; pointer-events: none; font-size: 0.7rem; opacity: 0.15; color: rgba(200,185,155,0.7); }

    @keyframes astroFade { 0% { opacity: 0; } 100% { opacity: 1; } }
    .astro-grid { position: relative; grid-auto-flow: dense; }
    .constellation { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: .55; }
    .astro-featured {
      position: relative; overflow: hidden; z-index: 10;
      border: 1px solid rgba((232,164, NaN),176, 0.25);
      box-shadow: 0 0 0 1px rgba(232,164,176,0.22), 0 0 42px rgba(232,164,176,0.16), inset 0 0 34px rgba(232,164,176,0.05);
      background: linear-gradient(155deg, rgba(54,32,96,0.5) 0%, rgba(22,12,48,0.62) 55%, rgba(15,8,35,0.72) 100%);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      transition: transform .45s cubic-bezier(.4,0,.2,1), box-shadow .45s, border-color .45s;
    }
    .astro-featured:hover { transform: translateY(-5px); border-color: rgba(243,229,171,0.78); box-shadow: 0 0 0 1px rgba(243,229,171,0.35), 0 0 54px rgba(232,164,176,0.26), inset 0 0 40px rgba(232,164,176,0.08); }
    .astro-featured .af-title { font-family: 'Cormorant Garamond', serif; font-weight: 700; color: #f3ead0; font-size: 1.7rem; line-height: 1.2; margin: .3rem 0 .9rem; }
    .astro-featured:hover .af-title { color: #f0e4c0; }
    .astro-featured .af-summary { color: rgba(205,198,222,0.8); font-size: .96rem; line-height: 1.6; max-width: 62ch; }
    .astro-badge { display: inline-block; font-family: 'Playfair Display', serif; letter-spacing: .22em; font-size: .66rem; color: #1a1208; background: linear-gradient(120deg, #ecd9a0, #c9a94e); padding: .28rem .85rem; border-radius: 2px; box-shadow: 0 0 18px rgba(232,164,176,0.4); }
    .astro-featured .astrolabe { position: absolute; top: -46px; right: -46px; width: 230px; height: 230px; opacity: .26; pointer-events: none; animation: orbitSlow 70s linear infinite; }
    .astro-node { position: relative; z-index: 10; }
    .astro-node::before { content: ""; position: absolute; top: 12px; right: 14px; width: 5px; height: 5px; border-radius: 50%; background: rgba(230,215,170,0.55); box-shadow: 0 0 8px rgba(212,200,160,0.6); z-index: 2; }
  </style>

  <div class="astro-page min-h-screen pt-3 px-4 pb-14 md:pt-4 md:px-6 md:pb-20 relative overflow-hidden bg-gradient-to-b from-[#121A33] via-[#1A2448] via-[#141F3D] to-[#0D1429]">

    <AtmosFlow density={25000} max={56} min={15} speed={0.7} alpha={0.55} />

    {stars1.map((s) => (<div class="star-fixed sf-1" style={`left:${s.left}%;top:${s.top}%;`}></div>))}
    {stars2.map((s) => (<div class="star-fixed sf-2" style={`left:${s.left}%;top:${s.top}%;`}></div>))}
    {stars3.map((s) => (<div class="star-fixed sf-3" style={`left:${s.left}%;top:${s.top}%;`}></div>))}

    <div class="aura-blob av-1"></div>
    <div class="aura-blob av-2"></div>

    <div class="orbital-container oc-1">
      <span class="zodiac-symbol" style="top:-8px;left:50%;transform:translateX(-50%)">♈</span>
      <span class="zodiac-symbol" style="top:8%;right:-4px">♉</span>
      <span class="zodiac-symbol" style="top:40%;right:-6px">♊</span>
      <span class="zodiac-symbol" style="bottom:-2px;left:50%;transform:translateX(-50%)">♋</span>
      <span class="zodiac-symbol" style="top:40%;left:-6px">♌</span>
      <span class="zodiac-symbol" style="top:8%;left:-4px">♍</span>
    </div>
    <div class="orbital-container oc-2">
      <span class="zodiac-symbol" style="top:-6px;left:50%;transform:translateX(-50%)">♎</span>
      <span class="zodiac-symbol" style="top:12%;right:-3px">♏</span>
      <span class="zodiac-symbol" style="top:45%;right:-5px">♐</span>
      <span class="zodiac-symbol" style="bottom:0;left:50%;transform:translateX(-50%)">♑</span>
      <span class="zodiac-symbol" style="top:45%;left:-5px">♒</span>
      <span class="zodiac-symbol" style="top:12%;left:-3px">♓</span>
    </div>
    <div class="orbital-container oc-3">
      <span class="zodiac-symbol" style="top:-5px;left:50%;transform:translateX(-50%)">☉</span>
      <span class="zodiac-symbol" style="top:18%;right:-4px">☽</span>
      <span class="zodiac-symbol" style="bottom:4px;left:50%;transform:translateX(-50%)">♃</span>
      <span class="zodiac-symbol" style="top:18%;left:-4px">♄</span>
    </div>

    <div class="mirror-orbital mo-1">
      <span class="mirror-symbol" style="top:-6px;left:50%;transform:translateX(-50%)">♎</span>
      <span class="mirror-symbol" style="top:10%;right:-4px">♏</span>
      <span class="mirror-symbol" style="top:45%;right:-6px">♐</span>
      <span class="mirror-symbol" style="bottom:-2px;left:50%;transform:translateX(-50%)">♑</span>
      <span class="mirror-symbol" style="top:45%;left:-6px">♒</span>
      <span class="mirror-symbol" style="top:10%;left:-4px">♓</span>
    </div>
    <div class="mirror-orbital mo-2">
      <span class="mirror-symbol" style="top:-4px;left:50%;transform:translateX(-50%)">☉</span>
      <span class="mirror-symbol" style="top:15%;right:-4px">☽</span>
      <span class="mirror-symbol" style="bottom:0;left:50%;transform:translateX(-50%)">♃</span>
    </div>
    <div class="mirror-orbital mo-3">
      <span class="mirror-symbol" style="top:-4px;left:50%;transform:translateX(-50%)">♈</span>
      <span class="mirror-symbol" style="top:12%;right:-4px">♌</span>
      <span class="mirror-symbol" style="bottom:0;left:50%;transform:translateX(-50%)">♐</span>
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      <header class="text-center pt-12 mb-6 md:pt-14 md:mb-10">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-5 tracking-wide" style="font-family: 'Cormorant Garamond', serif;">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#d4c8a0] via-[#e8dcc0] to-[#c0b080]">{title}</span>
        </h1>
        <p class="text-lg text-celestial max-w-2xl mx-auto leading-relaxed">{summary || "Decipher celestial influences and symbolic messages encoded in the fabric of space-time consciousness."}</p>
        <div class="mt-6 flex justify-center"><div class="w-16 h-px bg-gradient-to-r from-transparent via-[#b8a880] to-transparent"></div></div>
      </header>

      {featured && (
        <div class="astro-grid grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-7 pb-16">
          <svg class="constellation" viewBox="0 0 1000 900" preserveAspectRatio="none" aria-hidden="true">
            <g stroke="rgba(212,200,160,0.16)" stroke-width="1.1" fill="none" stroke-linecap="round">
              <path d="M120 90 L330 170 L520 110 L740 190" />
              <path d="M330 170 L250 340 L470 410 L700 360 L860 250" />
              <path d="M470 410 L380 600 L640 650 L860 540" />
              <path d="M250 340 L180 560 L380 600" />
              <path d="M640 650 L560 800 L820 810" />
              <path d="M740 190 L880 300 L900 470" />
              <path d="M180 560 L120 740 L300 800" />
            </g>
            <g fill="rgba(232,216,172,0.55)">
              <circle cx="120" cy="90" r="3"/><circle cx="330" cy="170" r="3"/>
              <circle cx="520" cy="110" r="3"/><circle cx="740" cy="190" r="3"/>
              <circle cx="250" cy="340" r="3"/><circle cx="470" cy="410" r="3"/>
              <circle cx="700" cy="360" r="3"/><circle cx="860" cy="250" r="3"/>
              <circle cx="380" cy="600" r="3"/><circle cx="640" cy="650" r="3"/>
              <circle cx="860" cy="540" r="3"/><circle cx="180" cy="560" r="3"/>
              <circle cx="560" cy="800" r="3"/><circle cx="820" cy="810" r="3"/>
              <circle cx="880" cy="300" r="3"/><circle cx="900" cy="470" r="3"/>
              <circle cx="120" cy="740" r="3"/><circle cx="300" cy="800" r="3"/>
            </g>
          </svg>

          <a href={featured.url} class="astro-featured rounded-3xl p-7 md:p-10 block lg:col-span-2" style="animation: astroFade .5s ease-out both;">
            <svg class="astrolabe" viewBox="0 0 200 200" aria-hidden="true">
              <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(232,164,176,0.5)" stroke-width="1"/>
              <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(232,164,176,0.85)" stroke-width="2" stroke-dasharray="1 13"/>
              <circle cx="100" cy="100" r="70" fill="none" stroke="rgba(232,164,176,0.4)" stroke-width="1"/>
              <circle cx="100" cy="100" r="48" fill="none" stroke="rgba(232,164,176,0.35)" stroke-width="1"/>
              <circle cx="100" cy="100" r="30" fill="none" stroke="rgba(232,164,176,0.3)" stroke-width="1" stroke-dasharray="2 8"/>
              <line x1="100" y1="6" x2="100" y2="194" stroke="rgba(232,164,176,0.3)" stroke-width="1"/>
              <line x1="6" y1="100" x2="194" y2="100" stroke="rgba(232,164,176,0.3)" stroke-width="1"/>
              <circle cx="100" cy="100" r="4" fill="rgba(243,229,171,0.7)"/>
            </svg>
            <span class="astro-badge">FEATURED · 置顶</span>
            <h3 class="af-title">{featured.title}</h3>
            {featured.summary && <p class="af-summary">{featured.summary}</p>}
            <div class="mt-5"><span class="text-xs text-gray-500">{featured.shortDate}</span></div>
          </a>

          {rest.map((r, i) => {
            const s = spans[i % spans.length];
            return (
              <a href={r.url}
                 class={`astro-node astro-card rounded-2xl p-5 md:p-7 block group${s === 2 ? ' lg:col-span-2' : ''}`}
                 style={`animation: astroFade ${i * 0.1 + 0.45}s ease-out both;`}>
                <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#d4c8a0] transition-colors duration-300">{r.title}</h3>
                {r.summary && <p class="text-celestial text-sm mb-4 leading-relaxed opacity-80">{r.summary.slice(0, 120)}{r.summary.length > 120 ? '…' : ''}</p>}
                <span class="text-xs text-gray-500">{r.shortDate}</span>
              </a>
            );
          })}
        </div>
      )}
      {!featured && (
        <div class="text-center py-20">
          <h3 class="text-2xl font-bold text-white mb-3">The Stars Are Aligning</h3>
          <p class="text-celestial max-w-md mx-auto opacity-70">Celestial wisdom is being charted. Cosmic revelations approach.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
