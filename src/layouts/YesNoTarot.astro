---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { title: string; summary?: string; }
const { title, summary } = Astro.props;
---
<BaseLayout title={title} description={summary} bodyClass="dc-page">
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap');

    .dc-page {
      --gold: #E8A4B0;
      --gold-bright: #F3E5AB;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% -10%, #2B2254 0%, transparent 55%),
        radial-gradient(ellipse at 80% 110%, #322968 0%, transparent 50%),
        linear-gradient(180deg, #1A1534 0%, #1A1534 100%);
      position: relative;
      overflow: hidden;
      padding: 5rem 1.25rem 6rem;
    }
    .dc-stars { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
    .dc-star {
      position: absolute; border-radius: 50%;
      background: #fff; opacity: .5;
      animation: dcTwinkle 4s infinite ease-in-out;
    }
    @keyframes dcTwinkle { 0%,100% { opacity:.15; transform: scale(.7);} 50% { opacity:.9; transform: scale(1.2);} }

    .dc-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; text-align: center; }
    .dc-title {
      font-family: 'Playfair Display', Georgia, serif; font-weight: 700;
      font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.15;
      letter-spacing: .02em; margin: 0 0 .6rem;
      background: linear-gradient(90deg, #e8d8b8, var(--gold-bright), #c0a880);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .dc-sub {
      font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic;
      font-size: clamp(1rem, 2.4vw, 1.25rem); color: rgba(223,214,193,.72);
      max-width: 34rem; margin: 0 auto 2.2rem;
    }

    .dc-field {
      width: 100%; max-width: 30rem; margin: 0 auto 1.4rem;
      font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.15rem;
      color: #f3ead0; background: rgba(255,255,255,.04);
      border: 1px solid rgba(232,164,176,.35); border-radius: 12px;
      padding: .85rem 1.1rem; text-align: center; outline: none;
      transition: border-color .3s ease, box-shadow .3s ease;
    }
    .dc-field::placeholder { color: rgba(223,214,193,.4); }
    .dc-field:focus { border-color: var(--gold-bright); box-shadow: 0 0 18px rgba(232,164,176,.25); }

    .dc-btn {
      display: inline-flex; align-items: center; gap: .5rem;
      font-family: 'Playfair Display', serif; font-weight: 600; font-size: 1rem; letter-spacing: .06em;
      padding: .95rem 2.4rem; border-radius: 9999px; cursor: pointer;
      color: #1a1206; border: none;
      background: linear-gradient(90deg, var(--gold), var(--gold-bright));
      box-shadow: 0 0 30px rgba(232,164,176,.35);
      transition: transform .25s ease, box-shadow .25s ease, opacity .25s ease;
    }
    .dc-btn:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 0 45px rgba(232,164,176,.6); }
    .dc-btn:active { transform: scale(.98); }
    .dc-btn:disabled { opacity: .5; cursor: not-allowed; }

    .dc-result {
      max-width: 560px; margin: 2.6rem auto 0;
      opacity: 0; transform: translateY(20px);
      transition: opacity .7s ease, transform .7s ease;
      pointer-events: none;
    }
    .dc-result.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .dc-answer {
      font-family: 'Playfair Display', serif; font-weight: 700;
      font-size: clamp(3rem, 12vw, 5.5rem); line-height: 1; margin: 0 0 .4rem;
      background: linear-gradient(90deg, var(--gold-bright), #fff3cf, var(--gold-bright));
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .dc-answer.no { background: linear-gradient(90deg, #f0a5c0, #ffd9e6, #f0a5c0); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .dc-confidence {
      font-family: 'Playfair Display', serif; font-size: .8rem; letter-spacing: .25em; text-transform: uppercase;
      color: rgba(232,164,176,.8); margin-bottom: 1.4rem;
    }
    .dc-oracle {
      font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic;
      font-size: 1.25rem; line-height: 1.6; color: rgba(243,229,171,.9);
      max-width: 34rem; margin: 0 auto 1.6rem;
    }
    .dc-divider { width: 90px; height: 1px; margin: 1.4rem auto; background: linear-gradient(90deg, transparent, rgba(232,164,176,.6), transparent); }
    .dc-cta {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.08rem; line-height: 1.6; color: rgba(210,200,180,.78);
      max-width: 40rem; margin: 0 auto;
    }
    .dc-cta a { color: var(--gold-bright); font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(243,229,171,.5); }
    .dc-cta a:hover { color: #fff; border-color: #fff; }

    html:not(.dark) .dc-page { background: radial-gradient(ellipse at 50% -10%, #ece3fb 0%, transparent 55%), linear-gradient(180deg, #f8f6fc 0%, #fbfaff 100%); }
    html:not(.dark) .dc-sub { color: #5b5470; }
    html:not(.dark) .dc-star { background: #7c3aed; }
    html:not(.dark) .dc-field { color: #2a2342; background: rgba(124,58,237,.04); border-color: rgba(124,58,237,.3); }
    html:not(.dark) .dc-field::placeholder { color: #9b93b5; }
    html:not(.dark) .dc-oracle { color: #3b2f63; }
    html:not(.dark) .dc-cta { color: #5b5470; }
    html:not(.dark) .dc-cta a { color: #7c3aed; border-color: rgba(124,58,237,.4); }
    html:not(.dark) .dc-cta a:hover { color: #4c1d95; border-color: #4c1d95; }
  </style>

  <div class="dc-page">
    <div class="dc-stars" id="dcStars"></div>

    <div class="dc-inner">
      <h1 class="dc-title">Yes / No Tarot</h1>
      <p class="dc-sub">Hold a question in your mind — out loud or silent — then ask the cards for a clear lean.</p>

      <input id="dcQuestion" class="dc-field" type="text" maxlength="120" placeholder="What are you asking? (optional)" />
      <div><button class="dc-btn" id="dcBtn">🔮 Ask the Cards</button></div>

      <div class="dc-result" id="dcResult">
        <h3 class="dc-answer" id="dcAnswer"></h3>
        <div class="dc-confidence" id="dcConfidence"></div>
        <p class="dc-oracle" id="dcOracle"></p>
        <div class="dc-divider"></div>
        <p class="dc-cta">
          For a fuller reading, explore our handpicked
          <a href="/reviews/">Mind Toolkits &amp; Reviews</a> or draw a deeper card in the
          <a href="/daily-oracle/">Daily Oracle</a>.
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
  (function () {
    var CARDS = ["The Fool","The Magician","The High Priestess","The Empress","The Emperor","The Hierophant","The Lovers","The Chariot","Strength","The Hermit","Wheel of Fortune","Justice","The Hanged Man","Death","Temperance","The Devil","The Tower","The Star","The Moon","The Sun","Judgement","The World"];
    var YES_NOTES = [
      "The current bends toward yes — move with it, but keep your eyes open.",
      "A yes, with conditions. Commit, then stay flexible as details surface.",
      "The signs lean yes. Trust the pull you already feel."
    ];
    var NO_NOTES = [
      "The cards lean no — not yet. Let the timing ripen before you push.",
      "A gentle no. What you seek may need a different shape or season.",
      "The answer is no for now. Revisit it once the ground is steadier."
    ];

    function initYesNo() {
      var btn = document.getElementById('dcBtn');
      var result = document.getElementById('dcResult');
      var qEl = document.getElementById('dcQuestion');
      var answerEl = document.getElementById('dcAnswer');
      var confEl = document.getElementById('dcConfidence');
      var oracleEl = document.getElementById('dcOracle');
      if (!btn) return;
      var asking = false;

      var wrap = document.getElementById('dcStars');
      if (wrap && !wrap.dataset.ready) {
        wrap.dataset.ready = '1';
        var frag = document.createDocumentFragment();
        for (var i = 0; i < 60; i++) {
          var s = document.createElement('div');
          s.className = 'dc-star';
          var size = (Math.random() * 2 + 1).toFixed(1);
          s.style.width = size + 'px'; s.style.height = size + 'px';
          s.style.left = (Math.random() * 100).toFixed(2) + '%';
          s.style.top = (Math.random() * 100).toFixed(2) + '%';
          s.style.animationDelay = (Math.random() * 4).toFixed(2) + 's';
          frag.appendChild(s);
        }
        wrap.appendChild(frag);
      }

      function ask() {
        if (asking) return;
        asking = true;
        btn.disabled = true;
        result.classList.remove('show');

        var yes = Math.random() < 0.5;
        var confidence = yes ? (62 + Math.floor(Math.random() * 34)) : (58 + Math.floor(Math.random() * 34));
        var card = CARDS[Math.floor(Math.random() * CARDS.length)];
        var notes = yes ? YES_NOTES : NO_NOTES;
        var note = notes[Math.floor(Math.random() * notes.length)];

        setTimeout(function () {
          answerEl.textContent = yes ? 'YES' : 'NO';
          answerEl.className = 'dc-answer' + (yes ? '' : ' no');
          confEl.textContent = confidence + '% confidence · ' + card;
          oracleEl.textContent = note;
          result.classList.add('show');
          btn.textContent = '🔄 Ask Again';
          btn.disabled = false;
          asking = false;
        }, 420);
      }

      btn.addEventListener('click', ask);
      qEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') ask(); });
    }

    document.addEventListener('astro:page-load', initYesNo);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initYesNo);
    } else {
      initYesNo();
    }
  })();
  </script>
</BaseLayout>
